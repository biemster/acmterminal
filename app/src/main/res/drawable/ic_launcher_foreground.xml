        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Terminal Header Divider Line -->
    <path
        android:pathData="M 26,40 L 82,40"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Three Small Status Dots in Header -->
    <path
        android:pathData="M 33,35 A 1.2,1.2 0 1,0 33,35.01"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 38,35 A 1.2,1.2 0 1,0 38,35.01"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 43,35 A 1.2,1.2 0 1,0 43,35.01"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Command Prompt '>' Symbol -->
