        android:pathData="M 36,49 L 45,56 L 36,63"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Terminal Prompt Cursor '_' -->
    <path
        android:pathData="M 49,63 L 60,63"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- ESP32 / USB Pin Indicators at bottom right -->
    <path
        android:pathData="M 66,51 L 72,51 M 66,56 L 72,56"
